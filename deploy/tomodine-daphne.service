[Unit]
Description=TomoDine Daphne ASGI Server (WebSockets)
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=tomodine
Group=tomodine
WorkingDirectory=/opt/tomodine/backend
EnvironmentFile=/opt/tomodine/backend/.env
ExecStart=/opt/tomodine/backend/venv/bin/daphne \
    -b 127.0.0.1 \
    -p 8001 \
    --access-logfile /var/log/tomodine/daphne-access.log \
    config.asgi:application
Restart=always
RestartSec=5
KillMode=mixed

[Install]
WantedBy=multi-user.target
