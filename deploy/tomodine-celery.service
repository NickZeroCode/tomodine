[Unit]
Description=TomoDine Celery Worker
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=tomodine
Group=tomodine
WorkingDirectory=/opt/tomodine/backend
EnvironmentFile=/opt/tomodine/backend/.env
ExecStart=/opt/tomodine/backend/venv/bin/celery -A config worker --loglevel=info --concurrency=2 --logfile=/var/log/tomodine/celery.log
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
