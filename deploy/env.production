# =============================================================================
# TomoDine — Production Environment Variables
# Copy this to /opt/tomodine/backend/.env on the EC2 server and fill in values.
# Wrap values with special characters (parentheses, $, !, *) in single quotes.
# =============================================================================

# Django
DJANGO_SECRET_KEY='CHANGE_ME_TO_A_RANDOM_50_CHAR_STRING'
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=YOUR_EC2_PUBLIC_IP,YOUR_DOMAIN,tomodine-backend.vercel.app

# Database (Neon PostgreSQL)
DATABASE_URL='postgresql://neondb_owner:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require'

# Redis
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CHANNEL_LAYER=true

# CORS / CSRF — your frontend origin(s)
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://YOUR_EC2_PUBLIC_IP
CSRF_TRUSTED_ORIGINS=https://YOUR_DOMAIN,https://YOUR_EC2_PUBLIC_IP

# AWS S3 — media file storage
AWS_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY='YOUR_S3_SECRET_KEY'
AWS_STORAGE_BUCKET_NAME=YOUR_BUCKET_NAME
AWS_S3_REGION_NAME=ap-southeast-1

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Customer ordering base URL
CUSTOMER_APP_BASE_URL=https://YOUR_DOMAIN/order

# Frontend
VITE_API_BASE_URL=https://YOUR_DOMAIN
VITE_WS_BASE_URL=wss://YOUR_DOMAIN
