{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://tomodine-backend.vercel.app/api/$1" },
    { "source": "/ws/(.*)", "destination": "https://tomodine-backend.vercel.app/ws/$1" },
    { "source": "/media/(.*)", "destination": "https://tomodine-backend.vercel.app/media/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
