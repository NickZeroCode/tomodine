# Django
DJANGO_SECRET_KEY=your-super-secret-production-key-here
DEBUG=false
DJANGO_ALLOWED_HOSTS=your-backend-project.vercel.app,.vercel.app
DJANGO_SETTINGS_MODULE=config.settings

# Database — Vercel Postgres or Neon; set via Vercel project env vars
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Redis — for Channels cross-instance WebSocket coordination
# Get from Vercel Marketplace (Upstash Redis) or external provider
REDIS_URL=redis://default:password@host:6379/0
USE_REDIS_CHANNEL_LAYER=true

# CORS — your Vercel frontend URL
CORS_ALLOWED_ORIGINS=https://your-frontend-project.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-frontend-project.vercel.app

# Customer app URL
CUSTOMER_APP_BASE_URL=https://your-frontend-project.vercel.app/order

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
