# Django settings
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — SQLite by default; set DB_ENGINE=postgresql for Postgres
# DB_ENGINE=postgresql
# DB_NAME=restaurant_saas
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Channels — InMemory by default; enable Redis for production
# USE_REDIS_CHANNEL_LAYER=true
# REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URL embedded in generated QR codes (customer ordering app)
CUSTOMER_APP_BASE_URL=http://localhost:5173/order

# JWT
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
